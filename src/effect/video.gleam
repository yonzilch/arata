//// Video enhancement effect.
////
//// Post-processes `.video-embed` figures generated by the `video` shortcode
//// and upgrades their native `<video>` elements with the default runtime
//// player. The baseline markup stays fully usable when enhancement fails:
//// the native video and its direct source link are never removed.
////
//// Because the post body is rendered via `element.unsafe_raw_html`, video
//// figures are in the DOM without player behavior. This effect runs after
//// each content view renders (`enhance`) and on route changes (`cleanup`).
////
//// The FFI lives in `src/ffi/video.ffi.mjs`. The `@external` declarations
//// have no-op Gleam fallback bodies so the project builds on Erlang.
////
//// Important invariants:
//// - runtime asset URLs come from `config` via this module; the FFI must
////   not guess them;
//// - callers pass the resolved `artplayer_cdn_url` / `hls_cdn_url` from
////   `config.Config`;
//// - the JavaScript side must never throw into the SPA if a runtime asset
////   fails to load.

import lustre/effect.{type Effect}

/// Enhance discoverable video embeds in the current document.
///
/// Loads the runtime player only when mounted content contains video
/// shortcode output and is safe to call repeatedly: already-enhanced
/// containers are skipped.
pub fn enhance(artplayer_url: String, hls_url: String) -> Effect(Nil) {
  use _ <- effect.from
  enhance_videos(artplayer_url, hls_url)
  Nil
}

/// Destroy every enhanced player in the current document.
///
/// Must run when article content is replaced or the route changes. The
/// native video elements are preserved (restored to visibility). Safe to
/// call repeatedly.
pub fn cleanup() -> Effect(Nil) {
  use _ <- effect.from
  cleanup_videos()
  Nil
}

@external(javascript, "../ffi/video.ffi.mjs", "enhance_videos")
fn enhance_videos(artplayer_url: String, hls_url: String) -> Nil

@external(javascript, "../ffi/video.ffi.mjs", "cleanup_videos")
fn cleanup_videos() -> Nil
